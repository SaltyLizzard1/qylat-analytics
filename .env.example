# Copy this to .env.local for local development.
# Add all of these to Vercel environment variables for production.

# Neon database connection string
# Get this from your Neon project dashboard -> Connection Details -> Connection string
DATABASE_URL=postgres://...

# Password to log into the analytics dashboard
# Make it something you'll remember but that isn't your main account password
ANALYTICS_PASSWORD=your-dashboard-password-here

# Session secret - a long random string, 32+ characters
# Generate one at: https://1password.com/password-generator/ (set to Random, 40 chars)
# Changing this value logs everyone out instantly
SESSION_SECRET=a-long-random-string-at-least-32-characters

# ---------------------------------------------------------------------------
# Meta Graph API (Facebook Page + linked Instagram account)
# Replaces Supermetrics. See README section "Getting the Meta credentials".
# ---------------------------------------------------------------------------

# Numeric ID of the QYLAT Facebook Page.
# Facebook Page -> About -> Page transparency.
#
# Do NOT try to discover this through /me/accounts. The Page sits inside a
# business portfolio and that edge returns an empty data array for this user
# even with pages_show_list granted. The ingestion code addresses the Page
# directly by this ID and never enumerates Pages.
META_PAGE_ID=

# Numeric ID of the Instagram Business account linked to that Page.
# Get it from: GET /<META_PAGE_ID>?fields=instagram_business_account
META_IG_USER_ID=

# Long-lived Page access token.
# Page tokens derived from a long-lived user token do not expire, but they die
# if you change your Facebook password or revoke the app.
# Required scopes: pages_show_list, pages_read_engagement, read_insights,
#                  instagram_basic, instagram_manage_insights
META_PAGE_ACCESS_TOKEN=

# Optional. Pin the Graph API version. Defaults to v25.0 in lib/meta.ts.
# META_GRAPH_VERSION=v25.0

# Shared secret protecting /api/sync/meta. Vercel Cron sends this automatically
# as "Authorization: Bearer $CRON_SECRET" once the variable is set on the project.
# Any long random string works.
CRON_SECRET=another-long-random-string

# ---------------------------------------------------------------------------
# Google Analytics 4 (quityourlifeandtravel.com)
# Powers the funnel view: what happened after someone clicked a /go/ link.
# ---------------------------------------------------------------------------

# Numeric GA4 property ID. Admin -> Property Settings.
# NOT the G-XXXXXXXX measurement ID, which the Data API rejects.
GA_PROPERTY_ID=

# The service account JSON key, base64 encoded. Base64 avoids the newline and
# quoting problems the raw private_key field causes in an env var:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('key.json')).toString('base64'))"
#
# The service account must also be added as a Viewer under
# GA4 Admin -> Property Access Management. The key authenticates but grants no
# access on its own, and skipping that step returns 403 with a valid key.
GA_SERVICE_ACCOUNT_B64=
